# Copia este archivo a .env y completa solo las claves que uses.
# Ninguna es obligatoria para arrancar el servidor.

DATA_DIR=./data/projects
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Groq (modelo preferido; si falla, el cliente prueba la cadena de fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=

# Cerebras AI
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_WORKER_NAME=dual-rag-ai-worker
# subdominio de la cuenta (sin .workers.dev), ej: mi-cuenta
CLOUDFLARE_WORKERS_SUBDOMAIN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Llama.cpp local
LLAMA_CPP_MODEL_PATH=./models/Llama-3.2-1B-Instruct-Q4_K_M.gguf
